# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to use the bot (it spends paid API credits).
# Leave empty, message the bot, and it replies with your id.
ALLOWED_USER_IDS=

# Claude, the tutor. If empty, the SDK falls back to an `ant auth login` profile.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# Azure AI Speech: speech-to-text + pronunciation assessment (ru-RU, en-US), optional TTS.
# Set both or neither.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# GA voices: ru-RU-SvetlanaNeural (default), ru-RU-DmitryNeural, ru-RU-DariyaNeural.
# Expressive, public preview, limited regions: ru-RU-Masha:MAI-Voice-2, ru-RU-Lev:MAI-Voice-2
# AZURE_TTS_VOICE=ru-RU-SvetlanaNeural
# Voice for the English course (learners of English): en-US-AvaNeural by default.
# AZURE_TTS_VOICE_EN=en-US-AvaNeural

# ElevenLabs TTS. List voice ids with: npm run voices:elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_v3
# Voice for the English course; defaults to ELEVENLABS_VOICE_ID (v3 voices are multilingual).
# ELEVENLABS_VOICE_ID_EN=

# OpenAI: word pictures for the 💎 ladder, TTS (gpt-4o-mini-tts) and fallback speech-to-text (no pronunciation scores).
# Without a key the ladder works without pictures. Check the key and model with: npm run smoke:image
OPENAI_API_KEY=
# OPENAI_TTS_VOICE=
# OPENAI_IMAGE_MODEL=marin

# Default voice: elevenlabs | azure | openai. Defaults to the first configured; switch live with /voice.
# TTS_PROVIDER=

# Postgres. Local: the mathias-pg Docker container from the README. Railway: ${{Postgres.DATABASE_URL}}.
DATABASE_URL=postgres://postgres:dev@localhost:55432/mathias
# Defaults for new learners; each learner can change them in ⚙️ Settings.
DEFAULT_TIMEZONE=Europe/Kyiv
DEFAULT_LESSON_TIMES=09:00,19:00
# Receives /stats, /notes, /schedule, /voices. Defaults to the first ALLOWED_USER_IDS entry.
# OWNER_USER_ID=
